[Unit]
Description=Fleeting Proxmox metrics exporter
After=network.target

[Service]
Type=simple
User=gitlab-runner
Group=gitlab-runner
RuntimeDirectory=fleeting-plugin-proxmox
RuntimeDirectoryMode=0755
StateDirectory=fleeting-plugin-proxmox
StateDirectoryMode=0750
ExecStart=/usr/local/bin/fleeting-plugin-proxmox metrics-exporter \
    --listen 127.0.0.1:9252 \
    --socket /run/fleeting-plugin-proxmox/metrics.sock \
    --control-socket /run/fleeting-plugin-proxmox/control.sock \
    --control-state-file /var/lib/fleeting-plugin-proxmox/control.json \
    --exceptions-file /run/fleeting-plugin-proxmox/exceptions
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
